[Unit]
Description=Provengo LogBot - alertas de rede via Telegram (parseia o syslog central)
Documentation=https://github.com/willianpsouza/ConfigurationCollector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Binario cross-compilado (GOOS=linux GOARCH=amd64) para /opt/provengo/logbot/
ExecStart=/opt/provengo/logbot/notifier -config /etc/provengo/logbot/logbot.conf
Restart=always
RestartSec=5
# Precisa LER /var/log/skynet.log (root:adm 640). Rodar como usuario no grupo
# que le o log (ex.: adm) ou usar setfacl. Ajuste User/Group conforme o servidor.
User=willian_pires
SupplementaryGroups=adm
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadOnlyPaths=/var/log
ReadWritePaths=/etc/provengo/logbot

[Install]
WantedBy=multi-user.target
